Configs: {
	NekoConfig: {
		LocalOnly: {
			Tooltip: 开启时只接受 127.0.0.1 的连接，更安全；关闭可允许局域网连接。
			Label: 仅允许本机连接
		}

		ModPort: {
			Tooltip: 本模组开放的控制接口端口。需与 neko_terraria 插件 plugin.toml 的 mod_port 一致。
			Label: 监听端口 (mod_port)
		}

		AutoSelectCharacter: {
			Tooltip: 在主菜单自动选择配置的角色。
			Label: 启动时自动选角色
		}

		PlayerName: {
			Tooltip: 自动加入或操作的目标角色名称。
			Label: 角色名称
		}

		DisplayName: Neko Config
	}
}
